<%= render partial: 'error', locals: { obj: event } %>

<% if params[:action] == 'index' || params[:action] == 'show' %>
  <%= render partial: 'inspect', locals: { event: event } %>
<% else %>
  <%= render partial: 'modify', locals: { event: event } %>
<% end %>

<% if params[:action] != 'index' %>
  <%= render 'footer' %>
<% else %>
  <br>
<% end %>
