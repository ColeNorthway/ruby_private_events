<div class="event">
  <h4><%= event.name %></h4>
  <p>Date: <%= event.date %></p>
  <p>Location: <%= event.location %></p>
  <p>Host: <%= event.host.username %></p>

  <% if params[:action] == 'index' %>
    <%= link_to "Show", event_path(event.id) %>
  <% end %>
  <% if event.host == @user && @logged_in %>
    <%= link_to "Edit", edit_event_path(event.id) %>
  <% elsif @logged_in && !event.attendees.include?(@user)%>
    <%= button_to "Attend", "/attend/#{event.id}", method: 'post' %>
  <% elsif @logged_in && event.attendees.include?(@user)%>
    <%= button_to "Leave", "/attend/#{event.id}", method: 'delete' %>
  <% end %>
</div>