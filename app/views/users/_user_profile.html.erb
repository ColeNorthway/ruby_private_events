<%= fields_for :user_profile, @user.user_profile do |profile_form| %>
  City: <%= profile_form.text_field :city%><br>
  State: <%= profile_form.text_field :state%><br>
  Country: <%= profile_form.text_field :country%><br>
  Male: <%= profile_form.radio_button :gender, "male", presence: true %><br>
  Female: <%= profile_form.radio_button :gender, "female", presence: true %><br>
  First Name: <%= profile_form.text_field :first_name %><br>
  Last Name: <%= profile_form.text_field :last_name %><br>
<% end %>