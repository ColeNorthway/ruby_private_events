<%= form_with model: @user, url: user_path, method: @user.new_record? ? :post : :patch do |form| %>
  <div>
    <%# Location and Personal Information %>
    <%= render 'user_profile' %>

    <%# Username and Email %>
    Username: <%= form.text_field :username, presence: true %><br>
    Email: <%= form.email_field :email, presence: true %><br>

    <%# Password challenge for reset %>
    <% unless @user.new_record? %>
      Current Password: <%= form.password_field :password_challenge, presence: true %><br>
    <% end %>

    <%# Password %>
    Password: <%= form.password_field :password, presence: true %><br>
    Confirm Password: <%= form.password_field :password_confirmation, presence: true %><br>
  </div>

  <%# Create a new user or edit existing %>
  <% if @user.new_record? %>
    <%= form.submit "Signup" %><br>
  <% else %>
    <%= form.submit "Save" %><br>
  <% end %>
<% end %>
