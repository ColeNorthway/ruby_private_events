<%= form_with model: @user, url: user_path, method: @user.new_record? ? :post : :patch do |form| %>
  <div>
    <%= fields_for :user_profile, @user.user_profile do |profile_form| %>
      <%= profile_form.text_field :city%>
      <%= profile_form.text_field :state%>
      <%= profile_form.text_field :country%>
      <%= form.radio_button :gender, "male", presence: true %>
      <%= form.label :male, "Male" %>
      <%= form.radio_button :gender, "female", presence: true %>
      <%= form.label :female, "Female" %>
      <%= form.text_field :first_name %>
      <%= form.text_field :last_name %>
    <% end %>

    <%= form.text_field :username, presence: true %>
    <%= form.email_field :email, presence: true %>

    <%# Password challenge for reset %>
    <% unless @user.new_record? %>
      <%= form.password_field :password_challenge, presence: true %>
    <% end %>

    <%= form.password_field :password, presence: true %>
    <%= form.password_field :password_confirmation, presence: true %>
  </div>

  <%# Create a new user or edit existing %>
  <% if @user.new_record? %>
    <%= form.submit "Signup" %>
  <% else %>
    <%= form.submit "Save" %>
  <% end %>
<% end %>
